{
  "name": "stream-to-android-player-extension",
  "version": "1.5.0",
  "description": "Browser extension (Chrome/Edge/Firefox, desktop + Android) that detects streaming videos and sends them to an external player.",
  "main": "background.js",
  "scripts": {
    "test": "node --test tests/host.test.js tests/handler.test.js tests/unit.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/chromium.test.js",
    "test:e2e:firefox": "node --test --test-concurrency=1 tests/e2e/firefox.test.js",
    "build:vidstack": "esbuild src/player.js --bundle --minify --format=esm --outfile=player.bundle.js",
    "build:shaka": "esbuild src/player-shaka.js --bundle --minify --format=iife --global-name=ShakaInit --outfile=player-shaka.bundle.js",
    "build": "npm run build:vidstack && npm run build:shaka",
    "target:chrome": "node scripts/build-extension.js --target=chrome",
    "target:firefox": "node scripts/build-extension.js --target=firefox",
    "package": "node scripts/build-extension.js --package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faisalbhuiyan3038/Stream-to-Android-Player-Extension.git"
  },
  "keywords": [
    "webextension",
    "hls",
    "m3u8",
    "vlc",
    "mpv"
  ],
  "author": "Faisal Bhuiyan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/faisalbhuiyan3038/Stream-to-Android-Player-Extension/issues"
  },
  "homepage": "https://github.com/faisalbhuiyan3038/Stream-to-Android-Player-Extension#readme",
  "dependencies": {
    "hls.js": "^1.6.16",
    "shaka-player": "^5.1.5",
    "vidstack": "^0.6.15"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "esbuild": "^0.28.0",
    "playwright": "^1.50.0",
    "selenium-webdriver": "^4.27.0"
  }
}
