{
  "name": "stream-to-android-player-extension",
  "version": "1.6.0",
  "description": "Browser extension (Chrome/Edge/Firefox, desktop + Android) that detects streaming videos and sends them to an external player.",
  "main": "background.js",
  "scripts": {
    "test": "node --test tests/host.test.js tests/handler.test.js tests/unit.test.js tests/subtitles.test.mjs tests/page-params.test.mjs tests/player-memory.test.mjs tests/prefetch.test.mjs tests/mp4-merge.test.mjs tests/downloader.test.mjs tests/segment-store.test.mjs",
    "make-fixture": "node tests/e2e/make-fixture.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/chromium.test.js",
    "test:e2e:mobile": "node --test --test-concurrency=1 tests/e2e/mobile.test.js",
    "audit:mobile": "node tests/e2e/mobile-audit.js",
    "test:e2e:firefox": "node --test --test-concurrency=1 tests/e2e/firefox.test.js",
    "build:vidstack": "esbuild src/player.js --bundle --minify --format=esm --outfile=player.bundle.js",
    "build:shaka": "esbuild src/player-shaka.js --bundle --minify --format=iife --global-name=ShakaInit --outfile=player-shaka.bundle.js",
    "build:download": "esbuild src/download.js --bundle --minify --format=iife --outfile=download.bundle.js",
    "build": "npm run build:vidstack && npm run build:shaka && npm run build:download",
    "target:chrome": "node scripts/build-extension.js --target=chrome",
    "target:firefox": "node scripts/build-extension.js --target=firefox",
    "package": "node scripts/build-extension.js --package",
    "package:native-host": "node scripts/build-extension.js --native-host",
    "release": "node scripts/build-release.js --target=all",
    "release:chrome": "node scripts/build-release.js --target=chrome",
    "release:firefox": "node scripts/build-release.js --target=firefox"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faisalbhuiyan3038/Stream-to-Android-Player-Extension.git"
  },
  "keywords": [
    "webextension",
    "hls",
    "m3u8",
    "vlc",
    "mpv"
  ],
  "author": "Faisal Bhuiyan",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/faisalbhuiyan3038/Stream-to-Android-Player-Extension/issues"
  },
  "homepage": "https://github.com/faisalbhuiyan3038/Stream-to-Android-Player-Extension#readme",
  "dependencies": {
    "hls.js": "^1.6.16",
    "shaka-player": "^5.1.5",
    "vidstack": "^0.6.15"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "esbuild": "^0.28.0",
    "playwright": "^1.50.0",
    "selenium-webdriver": "^4.27.0"
  }
}
